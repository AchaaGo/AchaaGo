# Copy to .env. Replace both secrets; never commit .env.
APP_ENV=development
BRAND_NAME=AchaaGo
PUBLIC_URL=http://localhost:8187
WEB_PORT=8187
# HTTPS (README "Production"): your domain, then run with --profile https.
# Set GATEWAY_BIND=127.0.0.1 at the same time so plain HTTP isn't public.
DOMAIN=
GATEWAY_BIND=0.0.0.0
BACKUP_KEEP_DAYS=14
POSTGRES_PASSWORD=replace-with-a-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_PHONE=+97699000001
SEED_DEMO_DRIVER=true
SMS_PROVIDER=console
# SMS_PROVIDER=http sends through any HTTP SMS gateway; fill these from the
# provider's API docs (README "SMS"). Placeholders: {phone} {message} {sender} {api_key}
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_HEADERS=
SMS_HTTP_BODY=
SMS_HTTP_BODY_FORMAT=json
SMS_HTTP_SUCCESS_TEXT=
SMS_API_KEY=
SMS_SENDER=
SMS_PHONE_FORMAT=local
MAPS_PROVIDER=demo
# Server key for MAPS_PROVIDER=google (restrict it to the server's IP). Enable Places API (New),
# Routes API and Geocoding API on it: address search, road routes and distances, and the street
# address of a map tap. The mobile app has no browser key, so it relies on this for all three.
GOOGLE_MAPS_API_KEY=
# Browser key for the customer web app's map and destination search
# (Maps JavaScript API + Places API). Leave empty to keep the decorative
# fallback map and the demo /places search. Never a real key here — see
# README.md "Google Maps (web)" for how to create and restrict one.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
QPAY_PROVIDER=demo
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
FCM_PROVIDER=console
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
CUSTOMER_CANCEL_STATUSES=pending,assigned,driver_arriving,arrived
DISPATCH_TIMEOUT_MINUTES=30
# Error alerts to a Telegram chat (README "Production"): telegram or console
ALERT_PROVIDER=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
