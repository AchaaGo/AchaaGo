# HTTPS front door (docker-compose.yml "caddy", profile "https").
# Caddy gets and renews the Let's Encrypt certificate on its own and
# redirects http:// to https://. Needs DOMAIN in .env and the domain's DNS
# A record pointing at this server, with ports 80 and 443 open. See README
# "Production".
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy gateway:8080
}
